# Resend API Key for sending sales enquiry emails to zipbi.official@gmail.com
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient email address
RESEND_TO=zipbi.official@gmail.com

# Sender email address (use your verified domain in production, or onboarding@resend.dev for testing)
RESEND_FROM=ZipBi Sales <onboarding@resend.dev>

# Port for standalone production server (optional, defaults to 3000)
PORT=3000

